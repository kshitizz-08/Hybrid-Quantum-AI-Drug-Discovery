# =============================================
# Hybrid Quantum-AI Drug Discovery Platform
# .gitignore
# =============================================

# ── Secrets & Environment ─────────────────────
.env
.env.local
.env.production
.env.*.local
*.secret

# ── Python ───────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ── Virtual Environments ─────────────────────
venv/
env/
.venv/
ENV/

# ── Database files ────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Node / Frontend ───────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── ML Models (large binary files) ───────────
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt
models/*.onnx
# Keep model metadata JSON
!models/*.json

# ── Reports (generated) ───────────────────────
reports/*.pdf
reports/*.html

# ── Jupyter Notebooks ─────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── OS ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDEs ──────────────────────────────────────
.idea/
.vscode/settings.json
*.swp
*.swo

# ── Docker ────────────────────────────────────
*.override.yml

# ── Alembic ───────────────────────────────────
# Keep migrations but not compiled versions

# ── Data (processed can be regenerated) ──────
data/processed/
# Keep raw data marker but not the actual large raw files in public repos
# data/raw/  (Keep raw CSVs for reproducibility — uncomment to exclude)
